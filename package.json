{
  "name": "nothin-replica",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:editor": "node --test tests/editor-model.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:deploy": "node scripts/check-deployment.mjs",
    "deploy:check": "npm run build && npm test && npm run check:deploy"
  },
  "devDependencies": {
    "vite": "6.4.5"
  },
  "engines": {
    "node": "24.x"
  }
}
